# Build artifacts / caches (regenerated by cargo build / npm install)
client-tauri/src-tauri/target/
client-tauri/src-tauri/gen/
crypto-core/target/
server/server/node_modules/

# CMake build output for the host app (regenerated by "cmake --build build --config
# Release" or build.bat) - Visual Studio project files, object files, and the compiled
# .exe/.dll's that installer/InnerCircleSetup.iss pulls from. Not source; large.
server/build/

# Runtime data - a fresh circle's data folder is created automatically on first host/run.
# This must NEVER be committed: it can contain a real TLS private key (tls-key.pem) and a
# circle's real (encrypted) data file from local testing.
server/server/data/

# OS/editor cruft
*.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Any stray env/secret files, just in case
.env
.env.*
*.pem
*.key

# Internal working logs - see the note in this repo's history/README about why these are kept
# local rather than published verbatim. Remove these two lines if you decide to publish them.
PLAN.md
HANDOFF.md

# The installer isn't part of this publish - just the client/server source (crypto-core,
# client-tauri, server). Excluding the whole directory rather than only its large/regenerated
# pieces, since it's out of scope entirely here, not merely something to avoid committing
# binaries for. (installer/README.txt still tells you where to get its own inputs if you ever
# publish or rebuild it separately.)
installer/

# Delivery/build zips - a packaged snapshot, not source; regenerate instead of committing.
*.zip

# A duplicate extracted copy of this same project (from unzipping a delivered build), not a
# real second source tree to publish alongside the one at the repo root.
linux/
